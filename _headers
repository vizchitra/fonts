# Cloudflare Workers Static Assets header rules.
#
# Fonts are CORS-restricted in a way images are not: without
# Access-Control-Allow-Origin a cross-origin @font-face silently fails to load,
# so vizchitra.com could not use anything served here. This is the single most
# load-bearing file in the deployment.

/fonts/v1/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  # Safe because /v1/ paths are immutable by contract: a font revision ships as
  # /v2/, it never changes bytes under an existing path.
  Cache-Control: public, max-age=31536000, immutable

/fonts/v1/manifest.json
  ! Access-Control-Allow-Origin
  Access-Control-Allow-Origin: *
  # Rules are additive, not overriding - without unsetting Cache-Control first,
  # this stacks onto the /fonts/v1/* rule above instead of replacing it,
  # producing a single header with two conflicting values. Measured with
  # `wrangler dev` against the built worker before landing this fix.
  ! Cache-Control
  Cache-Control: public, max-age=3600
