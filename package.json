		"playwright": "1.64.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
		"vite-plus": "0.3.2",
		"wrangler": "^4.151.1"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.4.0"
