{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fonts",
	// No `account_id` here on purpose — this repo is public. Wrangler takes it
	// from CLOUDFLARE_ACCOUNT_ID instead, which CI reads from the `production`
	// environment secrets. Deploys go through CI on merge to main; a one-off
	// local deploy needs the variable exported. See README.
	"compatibility_date": "2026-09-09",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Custom domain — needs the `vizchitra.com` zone on the `vizchitra` Cloudflare
	// account. Cloudflare creates the DNS record + certificate on first deploy.
	// CI authenticates with CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN, so the
	// account is not pinned here.
	"routes": [{ "pattern": "fonts.vizchitra.com", "custom_domain": true }]
}
